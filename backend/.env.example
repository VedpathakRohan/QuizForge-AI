PORT=5001
MONGO_URI=mongodb://localhost:27017/quizforge

# REQUIRED for quiz generation. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Optional: comma-separated model list, first is preferred.
# Google retires models often: https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
# Optional: per-request timeout in ms
GEMINI_TIMEOUT_MS=90000

# Optional: email OTP. If unset, signup shows/auto-uses the code (dev mode).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=yourpassword
